# Port exposed by the Spring Boot application
SERVER_PORT=8080

# Spring profile: dev, test, or prod
SPRING_PROFILES_ACTIVE=prod

# Enable OpenAPI and Swagger UI
SPRING_DOC_API_DOCS_ENABLED=true
SPRING_DOC_SWAGGER_UI_ENABLED=true

# Allowed frontend origins
CORS_ALLOWED_ORIGINS=http://localhost:3000

# P2P scheme: 01 = Bank, 02 = MNO, 03 = Non-bank
SOMQR_P2P_SCHEME_IDENTIFIER=01

# Financial institution name, maximum 35 characters according to the P2P document
SOMQR_P2P_FI_NAME=Galaxy International Bank

# Four-digit FI acquirer ID; the generator prefixes 01
SOMQR_P2M_FI_ACQUIRER_ID=0011

# MNO network: 01 = Hormuud, 02 = Somtel
SOMQR_P2M_MNO_NETWORK_ID=01
